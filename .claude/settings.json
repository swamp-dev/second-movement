{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch --list:*)",
      "Bash(git submodule status:*)",
      "Bash(git worktree list:*)",
      "Bash(git rev-parse:*)",
      "Bash(make:*)",
      "Bash(emmake make:*)",
      "Bash(scripts/ci-local.sh:*)",
      "Bash(./scripts/ci-local.sh:*)",
      "Bash(nix --extra-experimental-features 'nix-command flakes' develop -c make:*)",
      "Bash(nix --extra-experimental-features 'nix-command flakes' develop -c emmake make:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)"
    ]
  }
}
